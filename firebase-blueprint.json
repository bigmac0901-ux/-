{
  "entities": {
    "staff": {
      "title": "Staff",
      "description": "スタッフ情報",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "名前" },
        "loginId": { "type": "string", "description": "ログインID（手動追加用）" },
        "email": { "type": "string", "format": "email", "description": "メールアドレス（Googleログイン用）" },
        "role": { "type": "string", "enum": ["admin", "staff"], "description": "役割" },
        "color": { "type": "string", "description": "カレンダー表示色" },
        "isManual": { "type": "boolean", "description": "手動で追加されたスタッフかどうか" }
      },
      "required": ["name", "role"]
    },
    "shift": {
      "title": "Shift",
      "description": "シフト・スケジュール情報",
      "type": "object",
      "properties": {
        "staffId": { "type": "string", "description": "スタッフID" },
        "staffName": { "type": "string", "description": "スタッフ名" },
        "startTime": { "type": "string", "format": "date-time", "description": "開始時間" },
        "endTime": { "type": "string", "format": "date-time", "description": "終了時間" },
        "title": { "type": "string", "description": "予定タイトル" },
        "event": { "type": "string", "description": "イベント名" },
        "note": { "type": "string", "description": "備考" }
      },
      "required": ["staffId", "startTime", "endTime"]
    },
    "external_event": {
      "title": "External Event",
      "description": "外部から取得したイベント情報（試合日程、ライブなど）",
      "type": "object",
      "properties": {
        "date": { "type": "string", "format": "date", "description": "開催日" },
        "title": { "type": "string", "description": "イベント名" },
        "type": { "type": "string", "enum": ["v-varen", "velca", "live"], "description": "イベント種別" },
        "location": { "type": "string", "description": "開催場所" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "更新日時" }
      },
      "required": ["date", "title", "type"]
    }
  },
  "firestore": {
    "/staff/{staffId}": {
      "schema": "staff",
      "description": "スタッフ一覧"
    },
    "/shifts/{shiftId}": {
      "schema": "shift",
      "description": "シフト一覧"
    },
    "/external_events/{eventId}": {
      "schema": "external_event",
      "description": "外部イベント一覧"
    }
  }
}
